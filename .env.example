# --- Base de données (SQLite par défaut, PostgreSQL en production) ---
ACP_DATABASE_URL=sqlite:///./acp.db
# ACP_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/acp

# --- URLs inter-services ---
ACP_API_URL=http://localhost:8000
ACP_EVENT_SERVICE_URL=http://localhost:8001
ACP_PROVIDER_GATEWAY_URL=http://localhost:8002
# Secret partagé API/worker -> provider-gateway ; obligatoire hors endpoint de santé.
ACP_GATEWAY_SERVICE_TOKEN=
# Secret partagé API -> event-service ; obligatoire pour ingérer un événement.
ACP_EVENT_SERVICE_TOKEN=
# DANGEREUX, développement local uniquement : réactive le WebSocket anonyme historique.
ACP_UNSAFE_ALLOW_ANONYMOUS_EVENT_WEBSOCKET=0
# Origines explicites ; ne pas utiliser * avec une interface authentifiée.
ACP_CORS_ORIGINS=http://localhost:5173

# --- Accès propriétaire et session web ---
# Secret à usage unique pour le premier bootstrap ; générer une valeur aléatoire longue.
ACP_BOOTSTRAP_TOKEN=
ACP_SESSION_TTL_SECONDS=43200
# Laisser 0 uniquement en HTTP local ; utiliser 1 derrière HTTPS.
ACP_SESSION_COOKIE_SECURE=0

# --- Interface web (variables injectées au build Vite) ---
VITE_ACP_API_URL=http://localhost:8000
# Flux legacy uniquement : le WebSocket anonyme est fermé par défaut.
VITE_ACP_EVENTS_WS_URL=ws://localhost:8001/ws
# Le bureau pixel historique reste désactivé par défaut.
VITE_ACP_LEGACY_OFFICE=0

# --- Worker distant ---
ACP_WORKER_POLL_INTERVAL=2.0
ACP_ORCHESTRATOR_PROVIDER=hermes
# Secret d'enrôlement à générer avant `worker register`; aucune valeur par défaut.
ACP_WORKER_REGISTRATION_TOKEN=
# Pepper serveur optionnel : ne pas le configurer sur la machine worker
ACP_WORKER_TOKEN_PEPPER=
# ACP_WORKER_NAME=render-node-01
# ACP_WORKER_MAX_CONCURRENCY=1
# ACP_WORKER_STATE_DIR=C:\Users\me\.agent-company-worker
# La simulation est explicite et termine en `blocked`, jamais en succès.
ACP_WORKER_SIMULATION=1

# --- Répertoire des plugins ---
ACP_PLUGINS_DIR=./plugins

# --- Hermes Agent API Server 0.21.1 / image v2026.9.7 ---
# Local natif si activé : http://127.0.0.1:8642 (différent en conteneur/Railway).
HERMES_BASE_URL=
HERMES_API_KEY=
# Alias de migration uniquement : HERMES_SERVICE_TOKEN=
HERMES_TIMEOUT_SECONDS=30
HERMES_MAX_RETRIES=2
HERMES_RUN_TIMEOUT_SECONDS=120
HERMES_POLL_INTERVAL_SECONDS=0.5

# À configurer sur le service Hermes, pas sur le frontend :
# API_SERVER_ENABLED=true
# API_SERVER_KEY=<même secret que HERMES_API_KEY>
