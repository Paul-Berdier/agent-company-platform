# --- Base de données (SQLite locale ; PostgreSQL est la cible de production non livrée) ---
ACP_DATABASE_URL=sqlite:///./acp.db
# ACP_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/acp

# --- URLs inter-services ---
ACP_API_URL=http://localhost:8000
ACP_EVENT_SERVICE_URL=http://localhost:8001
ACP_PROVIDER_GATEWAY_URL=http://localhost:8002
# Secret partagé API/worker -> provider-gateway ; obligatoire hors endpoint de santé.
ACP_GATEWAY_SERVICE_TOKEN=
# Secret partagé API -> event-service ; obligatoire pour ingérer un événement.
ACP_EVENT_SERVICE_TOKEN=
# DANGEREUX, développement local uniquement : réactive le WebSocket anonyme historique.
ACP_UNSAFE_ALLOW_ANONYMOUS_EVENT_WEBSOCKET=0
# Origines explicites ; ne pas utiliser * avec une interface authentifiée.
ACP_CORS_ORIGINS=http://localhost:5173

# --- Accès propriétaire et session web ---
# Secret à usage unique pour le premier bootstrap ; générer une valeur aléatoire longue.
ACP_BOOTSTRAP_TOKEN=
ACP_SESSION_TTL_SECONDS=43200
# Laisser 0 uniquement en HTTP local ; utiliser 1 derrière HTTPS.
ACP_SESSION_COOKIE_SECURE=0

# --- Interface web (variables injectées au build Vite) ---
VITE_ACP_API_URL=http://localhost:8000
# Flux legacy uniquement : le WebSocket anonyme est fermé par défaut.
VITE_ACP_EVENTS_WS_URL=ws://localhost:8001/ws
# Le bureau pixel historique reste désactivé par défaut.
VITE_ACP_LEGACY_OFFICE=0

# --- Worker distant ---
ACP_WORKER_POLL_INTERVAL=2.0
# `mock` reste réservé à la simulation : le mode réel le refuse avant tout spawn.
ACP_ORCHESTRATOR_PROVIDER=hermes
# Secret d'enrôlement à générer avant `worker register`; aucune valeur par défaut.
ACP_WORKER_REGISTRATION_TOKEN=
# Pepper serveur optionnel : ne pas le configurer sur la machine worker
ACP_WORKER_TOKEN_PEPPER=
# ACP_WORKER_NAME=render-node-01
# ACP_WORKER_MAX_CONCURRENCY=1
# ACP_WORKER_STATE_DIR=C:\Users\me\.agent-company-worker
# La terminaison nominale de la simulation est `blocked`; une erreur de préparation
# peut être `failed`, mais une simulation n'est jamais promue en succès. Seules les
# valeurs 1 (simulation) et 0 (réel configuré) sont acceptées.
ACP_WORKER_SIMULATION=1
# Le mode réel exige un argv JSON local explicite et une racine dédiée. Le worker
# ajoute le chemin absolu de request.json comme dernier argument, sans shell.
# ACP_WORKER_RUNNER_ARGV_JSON=["C:\\Python312\\python.exe","C:\\acp-runner\\execute.py"]
# ACP_WORKER_RUN_ROOT=C:\\acp-runs
# ACP_WORKER_RUN_TIMEOUT_SECONDS=300
# ACP_WORKER_RUN_MAX_OUTPUT_BYTES=1048576
# Variables du processus enfant autorisées explicitement, séparées par des virgules.
# Ne jamais allowlister un secret : stdout/stderr sont bornés mais non expurgés.
# ACP_WORKER_RUN_ENV_ALLOWLIST=
# ACP_WORKER_RUN_TERMINATE_GRACE_SECONDS=1

# --- Répertoire des plugins ---
ACP_PLUGINS_DIR=./plugins

# --- Coffre de secrets (Lot D) ---
# Clés Fernet séparées par des virgules : la première chiffre, les suivantes servent
# encore au déchiffrement (rotation). Sans valeur, le coffre est « non configuré » et
# les routes de secrets le disent explicitement. Générer une clé :
#   python -m acp_api.secrets_vault generate-key
ACP_SECRETS_KEYS=

# --- Sorties réseau de l'API (anti-SSRF, Lot D) ---
# Adresses privées explicitement joignables (CIDR IPv4/IPv6 ou noms d'hôte exacts,
# séparés par des virgules). Vide = aucune adresse privée. Chaque usage est journalisé
# dans les événements (outbound.private_allowlist_used).
ACP_OUTBOUND_PRIVATE_ALLOWLIST=
# 1 autorise http:// vers le bouclage (127.0.0.1, ::1, localhost) ; vide ou 0 = refusé.
ACP_OUTBOUND_ALLOW_LOOPBACK_HTTP=

# --- Bibliothèque de skills (Lot D) ---
# Répertoire des révisions de skills importées (défaut ./acp-data/skills, ignoré par git).
ACP_SKILLS_STORAGE_DIR=
# Dossiers locaux importables comme skills, séparés par le séparateur du système
# (« ; » sous Windows, « : » ailleurs). Vide = import par dossier refusé (403).
ACP_SKILLS_ALLOWED_DIRS=
# 1 active l'import depuis GitHub (commit épinglé par SHA obligatoire) ; vide ou 0 = 503.
ACP_SKILLS_GITHUB_ENABLED=
# Jeton GitHub optionnel, envoyé uniquement à api.github.com quand il est défini.
ACP_GITHUB_TOKEN=

# --- Worker : probes MCP stdio (Lot D) ---
# 1 annonce la capacité mcp_stdio_probe (exige aussi la liste d'exécutables) ; vide ou 0 = désactivé.
ACP_WORKER_MCP_STDIO_ENABLED=
# Chemins absolus des exécutables MCP que ce runner accepte de lancer, séparés par le
# séparateur du système. Toute autre commande est refusée sans lancement.
ACP_WORKER_MCP_STDIO_ALLOWED_EXECUTABLES=
# Durée maximale d'un probe stdio en secondes (défaut 20, maximum 120).
ACP_WORKER_MCP_STDIO_TIMEOUT_SECONDS=

# --- Bibliothèque de livrables (Lot E) ---
# Racine des blobs adressés par contenu (défaut ./acp-data/artifacts, ignoré par git).
# Le nom d'origine d'un fichier n'entre jamais dans ce chemin : la clé est un sha256.
ACP_ARTIFACT_STORAGE_DIR=
# Clés de signature des liens de téléchargement, séparées par des virgules : la première
# signe, les suivantes vérifient encore (rotation). Sans valeur, les liens signés sont
# indisponibles (503 explicite) mais le téléchargement par session reste possible.
# Générer une clé : python -m acp_api.signing generate-key
ACP_ARTIFACT_SIGNING_KEYS=
# Taille maximale d'un livrable téléversé, en octets (défaut 209715200, soit 200 Mio).
ACP_ARTIFACT_MAX_BYTES=
# Quota cumulé de livrables par tentative, en octets (défaut 1073741824, soit 1 Gio).
ACP_ARTIFACT_MAX_BYTES_PER_RUN=
# Origine séparée servant les aperçus signés (ex. https://apercu.exemple.fr). Vide =
# les liens pointent vers l'API : ne pas exposer sur Internet sans origine d'aperçu dédiée.
ACP_ARTIFACT_PUBLIC_ORIGIN=
# Durée de conservation des contenus de livrables en jours (défaut 180). Une pièce
# référencée par une preuve de mission n'est jamais effacée par la rétention.
ACP_ARTIFACT_RETENTION_DAYS=

# --- Flux d'événements et rétention du journal (Lot E) ---
# Durée de conservation des événements en jours (défaut 90 ; 0 = illimité). Les
# événements terminaux d'une tentative sont conservés quoi qu'il arrive.
ACP_EVENT_RETENTION_DAYS=
# Intervalle d'interrogation de la base par le flux SSE, en millisecondes (défaut 400) :
# c'est la latence nominale annoncée aux utilisateurs.
ACP_STREAM_POLL_INTERVAL_MS=
# Période du commentaire keep-alive « : ping » en secondes (défaut 15).
ACP_STREAM_KEEPALIVE_SECONDS=
# Durée maximale d'une connexion SSE en secondes (défaut 900) ; au-delà, le serveur
# ferme proprement en indiquant le curseur pour que le client se reconnecte.
ACP_STREAM_MAX_SECONDS=
# Connexions SSE simultanées par utilisateur (défaut 4).
ACP_STREAM_MAX_CONNECTIONS_PER_USER=

# --- Worker : tests web Playwright (Lot E) ---
# 1 annonce la capacité web_tests (exige argv, cwd et ACP_WORKER_SIMULATION=0) ; vide ou 0 = désactivé.
ACP_WORKER_WEBTEST_ENABLED=
# Argv absolu du lanceur de tests, en JSON, sans shell. Exemple :
# ACP_WORKER_WEBTEST_ARGV_JSON=["C:/Program Files/nodejs/node.exe","C:/projets/app/node_modules/@playwright/test/cli.js","test"]
ACP_WORKER_WEBTEST_ARGV_JSON=
# Racine de projet autorisée pour lancer la suite (chemin absolu).
ACP_WORKER_WEBTEST_CWD=
# Durée maximale d'une exécution de tests en secondes (défaut 900, maximum 7200).
ACP_WORKER_WEBTEST_TIMEOUT_SECONDS=
# Taille maximale d'une pièce jointe téléversée par le worker, en octets (défaut 209715200).
ACP_WORKER_WEBTEST_MAX_ARTIFACT_BYTES=
# Variables transmises au processus de test, séparées par des virgules. Ne jamais
# allowlister un credential de la plateforme : le processus de test n'en reçoit aucun.
ACP_WORKER_WEBTEST_ENV_ALLOWLIST=

# --- Hermes Agent API Server 0.21.1 / image v2026.9.7 ---
# Local natif si activé : http://127.0.0.1:8642 (différent en conteneur/Railway).
HERMES_BASE_URL=
HERMES_API_KEY=
# Alias de migration uniquement : HERMES_SERVICE_TOKEN=
HERMES_TIMEOUT_SECONDS=30
HERMES_MAX_RETRIES=2
HERMES_RUN_TIMEOUT_SECONDS=120
HERMES_POLL_INTERVAL_SECONDS=0.5

# À configurer sur le service Hermes, pas sur le frontend :
# API_SERVER_ENABLED=true
# API_SERVER_KEY=<même secret que HERMES_API_KEY>
