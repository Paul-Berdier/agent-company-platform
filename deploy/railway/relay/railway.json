{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/python.Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "apps/cli/**",
      "apps/event-service/**",
      "apps/worker/**",
      "packages/**",
      "services/provider-gateway/**",
      "plugins/**",
      "requirements/**",
      "docker/python.Dockerfile",
      "docker/entrypoint.sh",
      "VERSION"
    ]
  },
  "deploy": {
    "startCommand": "/app/docker/entrypoint.sh relay",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
