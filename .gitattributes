*.sh text eol=lf
Dockerfile* text eol=lf
*.Dockerfile text eol=lf
# Tout ce qui entre dans l'image Hermes (scripts s6 sans extension, empreintes
# comparées octet pour octet avec l'image) garde des fins de ligne LF.
hermes/** text=auto eol=lf
# Image du fournisseur d'identité (scripts shell sans extension, gabarit) : LF.
identite/** text=auto eol=lf
# Image de l'exécutant Railway (politique, scripts shell sans extension) : LF.
executant/** text=auto eol=lf
# Infrastructure Railway (IaC, verrou npm, vérificateur) : LF, comme le reste des fichiers lus par
# des outils Unix (CLI Railway sous WSL, CI).
.railway/** text=auto eol=lf
# Sources des greffons d'interface (TypeScript, verrou npm, construction) : LF, comme les bundles
# qu'elles produisent sous hermes/plugins.
apps/interface/** text=auto eol=lf
# Skills vendorisées (hermes/catalogue/catalogue.lock.json) : octets amont à l'identique, fins de
# ligne LF ; deux fichiers amont portent des espaces en fin de ligne, gardés tels quels, que
# `git diff --check` ne doit pas signaler.
hermes/skills/emil-kowalski/** text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
hermes/skills/taste-skill/** text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
hermes/skills/ecc/** text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Trames exemples du flux d'invalidation (étape P7) : une trame SSE se termine par une ligne vide, octets comparés
# à ceux du greffon ; `git diff --check` ne doit pas signaler cette ligne vide finale.
hermes/tests/outils/fixtures_flux/** text eol=lf whitespace=-blank-at-eof
