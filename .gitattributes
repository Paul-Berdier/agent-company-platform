*.sh text eol=lf
Dockerfile* text eol=lf
*.Dockerfile text eol=lf
# Tout ce qui entre dans l'image Hermes (scripts s6 sans extension, empreintes
# comparées octet pour octet avec l'image) garde des fins de ligne LF.
hermes/** text=auto eol=lf
# Image du fournisseur d'identité (scripts shell sans extension, gabarit) : LF.
identite/** text=auto eol=lf
# Infrastructure Railway (IaC, verrou npm, vérificateur) : LF, comme le reste des fichiers lus par
# des outils Unix (CLI Railway sous WSL, CI).
.railway/** text=auto eol=lf
