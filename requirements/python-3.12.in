# Dépendances tierces du monorepo pour l'image Python 3.12 (Lot H5).
#
# Ce fichier est la source unique du verrou ``python-3.12.lock.txt`` : il réunit
# les dépendances déclarées par les dix ``pyproject.toml`` (apps/api, apps/cli,
# apps/event-service, apps/worker, packages/agent-sdk, packages/contracts,
# packages/database, packages/event-sdk, packages/provider-sdk,
# services/provider-gateway), l'extra ``[test]`` du provider-gateway et les trois
# épingles imposées par le Lot H (alembic, psycopg, sqlalchemy). Les distributions
# locales ``acp-*`` ne figurent pas ici : l'image les installe sans dépendances
# (``pip install --no-deps``) après le verrou.
#
# Recompilation (dans un conteneur python:3.12-slim, jamais sur le poste) :
#   scripts/lock_python.ps1   ou   scripts/lock_python.sh
# puis ``python scripts/check_lock.py`` pour vérifier verrou et contraintes.

# --- apps/api ---
fastapi>=0.111
uvicorn[standard]>=0.30
httpx>=0.27
argon2-cffi>=25.1.0,<26
cryptography>=45,<48
pyyaml>=6,<7

# --- packages/agent-sdk, packages/contracts ---
pydantic>=2.7
# ``tzdata`` n'est requis que sous Windows par acp-contracts, mais il est verrouillé
# sans marqueur : le fichier de contraintes dérivé du verrou sert aussi au poste
# local Windows, et le paquet ne contient que des données.
tzdata>=2024.1

# --- packages/database (épingles du Lot H) ---
sqlalchemy==2.0.51
alembic==1.20.0
psycopg[binary]==3.3.5

# --- services/provider-gateway[test] ---
pytest>=8
pytest-asyncio>=0.23

# --- Construction des distributions locales dans l'image (build-system des
# pyproject.toml : setuptools>=68). Verrouillés pour installer les paquets ``acp-*``
# avec ``--no-build-isolation`` sans télécharger un setuptools non épinglé.
setuptools>=68
wheel
