      "studio-graphite": "#626f74",
      "studio-papier": "#8b9699"
    },
    "status.notConfigured.foreground": {
      "$description": "Capacité présente dans l'interface mais non configurée. Aucun appel externe n'est déclenché, aucun bouton factice n'est proposé.",
      "$type": "color",
      "$label": "Non configuré",
      "$glyphName": "unplugged",
      "$asciiFallback": "-",
      "atelier-nuit": "#9ea3b8",
      "atelier-jour": "#5a5970",
      "studio-graphite": "#93a3a8",
      "studio-papier": "#5b6b6f"
    },
    "status.notConfigured.tint": {
