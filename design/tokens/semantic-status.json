  "$backendMapping": {
    "$description": "Correspondance entre les états réellement produits par le backend et les jetons ci-dessus. Deux états peuvent partager une famille de couleur : leur libellé, lui, reste distinct. Sources vérifiées à la rédaction sur la branche feat/desktop-qt-railway.",
    "$sources": [
      "apps/api/src/acp_api/routers/work.py:85-128 (_RUN_STATES, _TERMINAL_RUN_STATES, _TASK_STATUS_BY_RUN)",
      "apps/api/src/acp_api/routers/missions.py:69-76 (_ACTIVE_RUN_STATES, _RETRYABLE_RUN_STATES)",
      "apps/api/src/acp_api/gateway.py:22-31 (GatewayDiagnostic.status)",
      "apps/api/src/acp_api/readiness.py:52 (STATUS_DEGRADED)",
      "services/provider-gateway/src/acp_provider_gateway/providers/hermes/contracts.py:111-120 (HermesRunStatusState)",
      "apps/web/src/workspace.css:591-622 (tonalités actuelles des pastilles web)"
    ],
