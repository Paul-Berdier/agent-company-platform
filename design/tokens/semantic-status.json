{
  "$schema": "acp.design-tokens/1",
  "$description": "Couleurs sémantiques des états réels du produit. La couleur n'est jamais le seul porteur d'information : chaque état expose aussi un libellé français et un nom de glyphe. Trois rôles par état : foreground (texte, icône, point d'indicateur, mesuré au niveau AA), tint (fond de pastille), border (contour de pastille, mesuré au moins 3:1 contre surface.panel). La table $backendMapping relie chaque état à ce que l'API renvoie vraiment ; elle cite ses sources.",
  "$version": "2.0.0",
  "$file": "semantic-status",
  "$themed": true,
  "$themes": ["atelier-nuit", "atelier-jour", "studio-graphite", "studio-papier"],
  "$defaultTheme": "atelier-nuit",
  "$qml": {
    "singleton": "Status",
    "module": "Acp.Design",
    "propertyType": "color",
    "namingRule": "status.running.foreground -> statusRunningForeground. Les champs préfixés par $ sont des métadonnées et ne produisent pas de propriété de couleur ; le générateur les expose séparément (libellé, glyphe, priorité).",
    "listAccessor": "Le générateur produit aussi une fonction de résolution prenant l'identifiant d'état brut de l'API et renvoyant le jeu de jetons, d'après $backendMapping."
  },
  "$contrast": {
    "$description": "Seuils VÉRIFIÉS par le générateur pour les quatre thèmes (refus sous un seuil) : premier plan 4,5:1 sur canvas, panel, panelRaised et sunken, et sur sa propre teinte ; bordure 3:1 sur panel. Minima relevés dans docs/refonte/atelier-da.md.",
    "premierPlan": 4.5,
    "premierPlanSurTeinte": 4.5,
    "bordureSurPanneau": 3.0
  },
  "$priority": {
    "$description": "Ordre d'agrégation quand une liste ou un en-tête résume plusieurs états. Le premier rencontré l'emporte. Une réussite ne masque jamais un échec présent dans le même groupe.",
    "order": [
      "failed",
      "blocked",
      "approvalRequired",
      "degraded",
      "offline",
      "running",
      "pending",
      "notConfigured",
      "unknown",
      "succeeded"
    ]
  },
  "$shapeRules": {
    "$description": "Règles de forme rendant les états distinguables sans couleur, exigées par la doctrine du produit.",
    "dashedBorder": ["unknown", "notConfigured", "offline"],
    "solidBorder": ["pending", "running", "blocked", "failed", "succeeded", "degraded", "approvalRequired"],
    "animated": ["running"],
    "neverFilled": ["unknown", "notConfigured", "offline", "degraded"],
    "note": "Le remplissage plein est réservé à une pastille qui est aussi une cible d'action, par exemple « Approbation requise » quand elle ouvre la décision."
  },
  "$iconSet": {
    "$description": "Le jeu d'icônes n'est pas choisi à ce stade. Les noms de glyphe ci-dessous sont sémantiques ; la correspondance vers des ressources réelles est inconnue et sera décidée avec le premier écran natif.",
    "resolved": false
  },
  "tokens": {
    "status.unknown.foreground": {
      "$description": "Aucune mesure disponible. Ce n'est ni un zéro ni un succès : la plateforme affiche « Inconnu » plutôt qu'une valeur inventée.",
      "$type": "color",
      "$label": "Inconnu",
      "$glyphName": "question",
      "$asciiFallback": "?",
      "atelier-nuit": "#9ea3b8",
      "atelier-jour": "#5a5970",
      "studio-graphite": "#93a3a8",
      "studio-papier": "#5b6b6f"
    },
    "status.unknown.tint": {
      "$type": "color",
      "atelier-nuit": "#262b3a",
      "atelier-jour": "#efedf2",
