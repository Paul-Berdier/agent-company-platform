      },
      "blocked": {
        "token": "blocked",
        "label": "Bloqué"
      },
      "succeeded": {
        "token": "succeeded",
        "label": "Réussi"
      },
      "failed": {
        "token": "failed",
        "label": "En échec"
      },
      "cancelled": {
