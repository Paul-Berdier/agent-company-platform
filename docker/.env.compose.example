# Modèle de docker/.env.compose (copier, renseigner, ne jamais versionner : voir
# docker/.gitignore). Ce fichier sert deux usages dans docker/compose.yml :
#   1. l'interpolation ``${…}`` via ``docker compose --env-file docker/.env.compose`` ;
#   2. ``env_file:`` pour migrate, api, artifact-preview et relay (qui partagent la base).
# Les valeurs vides laissent les défauts du code ; les variables commentées sont
# transmises telles quelles si vous les décommentez. La signification de chaque
# variable est documentée dans .env.example et docs/deployment-railway.md.

# --- Version étiquetée sur les images (org.opencontainers.image.version) ---
# Copier ici le contenu du fichier VERSION à la racine ; compose ne peut pas le lire.
ACP_VERSION=0.9.0

# --- PostgreSQL (service postgres) ---
POSTGRES_USER=acp
POSTGRES_PASSWORD=
POSTGRES_DB=acp
# ACP_DATABASE_URL est dérivée automatiquement des trois valeurs ci-dessus.

# --- Réglages de pool et de délais (Lot H2, lus par l'API/aperçu/relais) ---
# ACP_DATABASE_POOL_SIZE=5
# ACP_DATABASE_MAX_OVERFLOW=10
# ACP_DATABASE_POOL_TIMEOUT_SECONDS=30
# ACP_DATABASE_CONNECT_TIMEOUT_SECONDS=10
# ACP_DATABASE_LOCK_TIMEOUT_MS=5000
# ACP_DATABASE_STATEMENT_TIMEOUT_MS=30000
# ACP_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000

# --- Relais d'outbox (Lot H3) ---
# ACP_EVENT_RELAY_ENABLED=1
# ACP_OUTBOX_MAX_ATTEMPTS=5

# --- Ports publiés sur 127.0.0.1 ---
ACP_API_PORT=8000
ACP_EVENTS_PORT=8001
ACP_GATEWAY_PORT=8002
ACP_PREVIEW_PORT=8010
ACP_WEB_PORT=8080

# --- Secrets inter-services (générer des valeurs aléatoires longues, distinctes) ---
ACP_GATEWAY_SERVICE_TOKEN=
ACP_EVENT_SERVICE_TOKEN=
ACP_BOOTSTRAP_TOKEN=

# --- API ---
ACP_API_URL=http://localhost:8000
ACP_CORS_ORIGINS=http://localhost:8080
# Adresses ou réseaux autorisés à poser X-Forwarded-Proto / X-Forwarded-For
# (docker/entrypoint.sh, services api et preview). Vide = boucle locale seulement,
# ce qui est correct pour cette pile : aucun proxy ne se place devant les conteneurs.
# À renseigner uniquement derrière une terminaison TLS en amont.
ACP_TRUSTED_PROXY_IPS=
ACP_SESSION_TTL_SECONDS=43200
# 0 uniquement parce que la pile locale est en HTTP ; 1 derrière HTTPS.
ACP_SESSION_COOKIE_SECURE=0
# Clés Fernet : python -m acp_api.secrets_vault generate-key
ACP_SECRETS_KEYS=
# Clés de signature : python -m acp_api.signing generate-key
ACP_ARTIFACT_SIGNING_KEYS=
# Origine de l'aperçu (service artifact-preview), distincte de l'API et du web.
ACP_ARTIFACT_PUBLIC_ORIGIN=http://localhost:8010
ACP_OUTBOUND_PRIVATE_ALLOWLIST=
ACP_OUTBOUND_ALLOW_LOOPBACK_HTTP=
ACP_SKILLS_ALLOWED_DIRS=
ACP_SKILLS_GITHUB_ENABLED=
ACP_GITHUB_TOKEN=

# --- Web (figé au build de l'image acp-web : URL de l'API vue du navigateur) ---
VITE_ACP_API_URL=http://localhost:8000
VITE_ACP_LEGACY_OFFICE=0

# --- Provider gateway : Hermes et ComfyUI ---
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_TIMEOUT_SECONDS=30
HERMES_MAX_RETRIES=2
HERMES_RUN_TIMEOUT_SECONDS=120
HERMES_POLL_INTERVAL_SECONDS=0.5
ACP_COMFYUI_ENABLED=0
