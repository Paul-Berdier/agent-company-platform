#!/bin/sh
# ACP 1.0.1 : conserver s6-overlay en PID 1 ; sous un init de plateforme,
# passer au bootstrap explicite qui valide les mêmes gardes AVANT s6-svscan.
# Ne jamais appeler le repli amont non supervisé de entrypoint-dispatch.sh.
if [ "$$" -eq 1 ]; then
    exec /opt/hermes/docker/entrypoint-dispatch.sh "$@"
fi
exec /opt/hermes/.venv/bin/python -I -B /opt/acp/bin/acp_init_plateforme.py \
    /opt/hermes/docker/main-wrapper.sh "$@"
